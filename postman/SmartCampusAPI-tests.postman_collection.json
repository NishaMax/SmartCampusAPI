{
  "info": {
    "name": "SmartCampusAPI - Automated Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    }
  ],
  "item": [
    {
      "name": "01 - Discovery (GET /)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Discovery status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Discovery returns JSON', function () { pm.response.to.be.json; });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Create room LIB-301 (POST /rooms)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"id\": \"LIB-301\", \"name\": \"Library Quiet Study\", \"capacity\": 40 }"
        },
        "url": "{{baseUrl}}/rooms"
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": [
            "pm.test('Create room returns 201', function () { pm.response.to.have.status(201); });",
            "pm.test('Location header present', function () { pm.expect(pm.response.headers.get('Location')).to.include('/rooms/LIB-301'); });",
            "pm.test('Response body contains id', function () { var json = pm.response.json(); pm.expect(json.id).to.eql('LIB-301'); });"
          ] }
        }
      ]
    },
    {
      "name": "03 - Create sensor TEMP-001 (valid) (POST /sensors)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"id\": \"TEMP-001\", \"type\": \"Temperature\", \"status\": \"ACTIVE\", \"currentValue\": 0, \"roomId\": \"LIB-301\" }" },
        "url": "{{baseUrl}}/sensors"
      },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('Create sensor returns 201', function () { pm.response.to.have.status(201); });",
        "pm.test('Response JSON has id TEMP-001', function () { var j = pm.response.json(); pm.expect(j.id).to.eql('TEMP-001'); });"
      ] } } ]
    },
    {
      "name": "04 - Create sensor with missing room (expect 422)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"id\": \"BAD-001\", \"type\": \"Temp\", \"status\": \"ACTIVE\", \"currentValue\": 0, \"roomId\": \"NOPE\" }" },
        "url": "{{baseUrl}}/sensors"
      },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('Missing linked room -> 422', function () { pm.response.to.have.status(422); });",
        "pm.test('Error body contains UNPROCESSABLE_ENTITY code', function () { var j = pm.response.json(); pm.expect(j.code).to.eql('UNPROCESSABLE_ENTITY'); pm.expect(j.status).to.eql(422); });"
      ] } } ]
    },
    {
      "name": "05 - Create duplicate sensor TEMP-001 (expect 409)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"id\": \"TEMP-001\", \"type\": \"Temperature\", \"status\": \"ACTIVE\", \"currentValue\": 0, \"roomId\": \"LIB-301\" }" },
        "url": "{{baseUrl}}/sensors"
      },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('Duplicate sensor -> 409 Conflict', function () { pm.response.to.have.status(409); });",
        "pm.test('Error JSON has CONFLICT code', function () { var j = pm.response.json(); pm.expect(j.code).to.eql('CONFLICT'); });"
      ] } } ]
    },
    {
      "name": "06 - List sensors (GET /sensors)",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/sensors" },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('List sensors 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Expect an array', function () { var j = pm.response.json(); pm.expect(Array.isArray(j)).to.be.true; });",
        "pm.test('TEMP-001 present', function () { var arr = pm.response.json(); var found = arr.some(function(s){return s && s.id === 'TEMP-001'}); pm.expect(found).to.be.true; });"
      ] } } ]
    },
    {
      "name": "07 - Filter sensors by type (GET /sensors?type=Temperature)",
      "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/sensors?type=Temperature","host":["{{baseUrl}}"],"path":["sensors"],"query":[{"key":"type","value":"Temperature"}] } },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('Filter returns 200', function () { pm.response.to.have.status(200); });",
        "pm.test('All returned sensors are type Temperature', function () { var arr = pm.response.json(); arr.forEach(function(s){ pm.expect(s.type.toLowerCase()).to.eql('temperature'); }); });"
      ] } } ]
    },
    {
      "name": "08 - Add reading to TEMP-001 (POST /sensors/TEMP-001/readings)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"id\": \"R-001\", \"timestamp\": 1710000000000, \"value\": 23.5 }" },
        "url": "{{baseUrl}}/sensors/TEMP-001/readings"
      },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('Add reading returns 201', function () { pm.response.to.have.status(201); });",
        "pm.test('Reading id is R-001', function () { var j = pm.response.json(); pm.expect(j.id).to.eql('R-001'); });"
      ] } } ]
    },
    {
      "name": "09 - Create OFFLINE sensor and attempt to add reading (403)",
      "item": [
        {
          "name": "09a - Create TEMP-OFF (POST /sensors)",
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{ \"id\": \"TEMP-OFF\", \"type\": \"Temperature\", \"status\": \"OFFLINE\", \"currentValue\": 0, \"roomId\": \"LIB-301\" }" }, "url": "{{baseUrl}}/sensors" },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test('Create TEMP-OFF 201', function(){ pm.response.to.have.status(201); });" ] } } ]
        },
        {
          "name": "09b - Add reading to TEMP-OFF (expect 403)",
          "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{ \"id\": \"R-OFF\", \"timestamp\": 1710000001000, \"value\": 10.0 }" }, "url": "{{baseUrl}}/sensors/TEMP-OFF/readings" },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test('OFFLINE sensor rejects reading -> 403', function(){ pm.response.to.have.status(403); });", "pm.test('Error body code is FORBIDDEN', function(){ var j = pm.response.json(); pm.expect(j.code).to.eql('FORBIDDEN'); });" ] } } ]
        }
      ]
    },
    {
      "name": "10 - Attempt to change sensor id with PUT (expect 400)",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"id\": \"TEMP-999\", \"type\": \"Temperature\", \"status\": \"ACTIVE\", \"currentValue\": 0, \"roomId\": \"LIB-301\" }" },
        "url": "{{baseUrl}}/sensors/TEMP-001"
      },
      "event": [ { "listen": "test", "script": { "exec": [ "pm.test('Changing id -> 400', function(){ pm.response.to.have.status(400); });" ] } } ]
    },
    {
      "name": "11 - Delete sensor TEMP-001 (DELETE /sensors/TEMP-001)",
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/sensors/TEMP-001" },
      "event": [ { "listen": "test", "script": { "exec": [ "pm.test('Delete sensor returns 204', function(){ pm.response.to.have.status(204); });" ] } } ]
    },
    {
      "name": "12 - Delete room LIB-301 while sensors exist (expect 409)",
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/rooms/LIB-301" },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('Delete room with sensors -> 409', function(){ pm.response.to.have.status(409); });",
        "pm.test('Error body contains CONFLICT code', function(){ var j = pm.response.json(); pm.expect(j.code).to.eql('CONFLICT'); });"
      ] } } ]
    }
  ]
}
